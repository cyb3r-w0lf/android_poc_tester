# Copy to .env and edit. run.sh regenerates SU_NAME on every start.

# Web
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
WEB_PORT=5000

# Proof of Work (kctf/pwn.red-compatible VDF, SELF-HOSTED solver at /solve, no external domain).
# ON by default to throttle shared-emulator abuse. POW_DIFFICULTY = sequential rounds the player
# must compute (higher = slower upload; ~250000 is a few seconds). Verifying is cheap server-side.
# Set ENABLE_POW=false ONLY for local testing.
ENABLE_POW=true
POW_DIFFICULTY=250000

# Uploads / queue
MAX_FILE_SIZE=100        # MB
MAX_QUEUE_SIZE=50
MAX_JOBS_PER_SESSION=1   # concurrent in-flight jobs per session cookie (anti-DoS)
MAX_JOBS_PER_IP=2        # concurrent in-flight jobs per source IP (cookie-independent)

# Behind a TLS proxy set this true so the ownership cookie is HTTPS-only.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Finished jobs + their screenshots are deleted after this many seconds.
JOB_RETENTION_SECONDS=3600

# Socket.IO allowed origins: "*" or a comma-separated list of your site origins (prod).
CORS_ORIGINS=*

# Seconds to wait after the POC runs before the proof screenshot (per-challenge
# override via SCREENSHOT_DELAY in the challenge's client.py).
SCREENSHOT_DELAY=3

# Backend forwards for challenges whose app talks to a server. Comma/space list of
# "PORT" (-> host.containers.internal:PORT) or "LISTEN:HOST:PORT". The emulator reaches
# these as 10.0.2.2:<LISTEN>. The emulator-side LISTEN port is FIXED (what the app uses);
# map it to whatever (possibly random) host/service port your orchestrator assigned:
#   BACKEND_FORWARDS=3014                         # 10.0.2.2:3014 -> host:3014
#   BACKEND_FORWARDS=3014:chalB-backend:48123     # 10.0.2.2:3014 -> that service's (random) port
BACKEND_FORWARDS=

# Egress lockdown (recommended ON in production): app UIDs inside the emulator may reach ONLY
# the backend forward, the allowlist below, and loopback; all other egress is rejected. Cloud
# metadata (169.254.0.0/16) is ALWAYS blocked. Neutralises SSRF. Set false only if a challenge
# genuinely needs open internet.
EGRESS_LOCKDOWN=true

# Extra hosts the emulator apps may reach (e.g. an independently-spawned challenge backend on a
# known IP). Comma/space list of IPs or CIDRs. Empty = only the backend forward + loopback.
EGRESS_ALLOW=
# Restrict EGRESS_ALLOW to a port or range (iptables syntax, colon for range). Empty = all ports.
EGRESS_ALLOW_PORTS=1024:65535
# Ports blocked even on allowlisted hosts (comma list), e.g. ssh/db. Empty = none.
EGRESS_DENY_PORTS=22,3306

# opsscheduler challenge: the admin-fixed backend URL the app fetches (emulator-side, FIXED).
OPSSCHED_BACKEND=http://10.0.2.2:3014

# Device connectivity (web -> device container)
ADB_HOST=device
ADB_PORT=5037

# Emulator
MAX_MEMORY=4096

# Root prevention: su is renamed to SU_NAME (root:shell 6750); SU_REMOVE=true also deletes it.
# SU_NAME is generated by run.sh.
SU_NAME=su-changeme
SU_REMOVE=true
